---
import '@/styles/global.css';
// URL resolue par Vite (nom avec empreinte) : permet de precharger la police
// du titre principal, qui porte le LCP, sans attendre l'analyse du CSS.
import headingFont from '@fontsource/barlow-condensed/files/barlow-condensed-latin-700-normal.woff2?url';
import bodyFont from '@fontsource/barlow/files/barlow-latin-400-normal.woff2?url';
import Seo from '@/components/Seo.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

import type { Crumb } from '@/components/Seo.astro';

interface Props {
  title: string;
  description: string;
  path: string;
  image?: string;
  noindex?: boolean;
  pageType?: 'WebPage' | 'AboutPage' | 'ContactPage' | 'CollectionPage';
  breadcrumb?: Crumb[];
  extraSchema?: Record<string, unknown>[];
}
const { title, description, path, image, noindex, pageType, breadcrumb, extraSchema } =
  Astro.props;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1e2b3a" />
    <link rel="preload" href={headingFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Seo {title} {description} {path} {image} {noindex} {pageType} {breadcrumb} {extraSchema} />
  </head>
  <body>
    <a href="#contenu" class="skip-link">Aller au contenu</a>
    <Header />
    <main id="contenu"><slot /></main>
    <Footer />
  </body>
</html>
