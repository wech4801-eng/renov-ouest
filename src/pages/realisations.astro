---
import { url } from '@/lib/url';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { projects } from '@/data/projects';
import { getService, services } from '@/data/services';

// Aucune fiche n'est fabriquee : quand `projects` est vide, la page affiche un
// etat vide honnete et se retire de l'index (une galerie sans chantier n'a
// aucune valeur de recherche). Des qu'une realisation est ajoutee dans
// src/data/projects.ts, la page redevient indexable et rejoint le sitemap.
const isEmpty = projects.length === 0;

const cards = projects.map((p) => ({
  title: p.title,
  type: getService(p.serviceSlug)?.name ?? '',
  desc: p.description,
  meta: [p.location, p.year].filter(Boolean).join(' · '),
  cover: p.cover ?? null,
}));
---
<BaseLayout
  title="Réalisations — Projets de rénovation | Renov'Ouest Angers"
  description="Les projets de rénovation menés par Rénov'Ouest à Saint-Jean-de-la-Croix, Angers et en Maine-et-Loire : rénovation complète, intérieure et extérieure."
  path="/realisations"
  noindex={isEmpty}
  pageType="CollectionPage"
  breadcrumb={[{ name: "Accueil", path: "/" }, { name: "Réalisations" }]}
>
  <PageHeader
    kicker="RÉALISATIONS"
    title="Des projets transformés de A à Z"
    intro={isEmpty
      ? "Découvrez bientôt les réalisations Rénov’Ouest et notre manière d’aborder chaque projet : une vision globale de la rénovation, un travail soigné et une attention particulière portée au résultat final."
      : "Découvrez les réalisations Rénov’Ouest et notre manière d’aborder chaque projet : une vision globale de la rénovation, un travail soigné et une attention particulière portée au résultat final."}
    titleWidth={30}
  />

  <section>
    <div style="max-width: var(--shell); margin: 0 auto; padding: clamp(36px, 5vw, 76px) var(--gutter)">
      {isEmpty ? (
        <div class="blueprint on-surface" style="position: relative; padding: clamp(24px, 4vw, 40px); background: var(--color-accent-100)">
          <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
          <p style="font-size: 15.5px; line-height: 1.6; margin: 0; max-width: 62ch; color: var(--color-neutral-800)">
            Aucun projet n’est publié pour le moment. Chaque réalisation présentée ici
            correspondra à un chantier réellement mené par Rénov’Ouest, avec ses photos, la nature
            des travaux — rénovation complète, intérieure ou extérieure — la commune et l’année.
          </p>
          <p style="font-size: 15.5px; line-height: 1.6; margin: 14px 0 0; max-width: 62ch; color: var(--color-neutral-800)">
            En attendant, le détail de chacun de nos savoir-faire décrit précisément notre façon
            de travailler, de la préparation des supports jusqu’aux finitions&nbsp;:
          </p>
          <ul style="list-style: none; padding: 0; margin: 20px 0 0; display: flex; flex-wrap: wrap; gap: 10px">
            {services.map((s) => (
              <li>
                <a class="tag tag-outline" href={url(`/prestations/${s.slug}`)}
                   style="text-decoration: none; display: inline-flex; min-height: 40px; align-items: center">
                  {s.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ) : (
        <div style="display: grid; gap: 22px; grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr))">
          {cards.map((c) => (
            <article class="card blueprint reveal" style="padding: 0; gap: 0">
              <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
              {c.cover && (
                <img src={c.cover.src} alt={c.cover.alt} loading="lazy" decoding="async"
                     width="1200" height="900"
                     style="aspect-ratio: 4 / 3; object-fit: cover; width: 100%; border-bottom: 1px solid var(--color-divider)" />
              )}
              <div style="padding: 22px; display: flex; flex-direction: column; gap: 8px">
                <span class="tag tag-outline">{c.type}</span>
                <h2 style="font-family: var(--font-heading); font-size: 21px; margin: 4px 0 0">{c.title}</h2>
                <p style="font-size: 13.5px; line-height: 1.55; margin: 0; color: var(--color-neutral-700)">{c.desc}</p>
                <p style="font-family: var(--font-mono); font-size: 11px; margin: 4px 0 0; color: var(--color-neutral-600)">{c.meta}</p>
              </div>
            </article>
          ))}
        </div>
      )}

      <div style="margin-top: 36px">
        <a class="btn btn-primary blueprint" href={url('/contact')} data-analytics="click_quote"
           style="white-space: nowrap; min-height: 54px; padding: 15px 24px; font-size: 16px">
          <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
          Demander un devis
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
