---
import { url } from '@/lib/url';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { company } from '@/data/company';
import { services } from '@/data/services';

const { address, geo } = company;
const dest = encodeURIComponent(`${address.street} ${address.postalCode} ${address.city}`);
const itinerary = `https://www.google.com/maps/dir/?api=1&destination=${dest}`;
const mapEmbed = `https://www.openstreetmap.org/export/embed.html?bbox=${geo.longitude - 0.06}%2C${geo.latitude - 0.03}%2C${geo.longitude + 0.06}%2C${geo.latitude + 0.03}&layer=mapnik&marker=${geo.latitude}%2C${geo.longitude}`;
const h2 = 'font-family: var(--font-heading); font-size: clamp(24px, 2.6vw, 34px); margin: 0 0 22px; text-transform: uppercase; letter-spacing: -0.02em';
---
<BaseLayout
  title="Entreprise de rénovation à Angers et en Maine-et-Loire | Renov'Ouest"
  description="Rénov'Ouest intervient à Saint-Jean-de-la-Croix, Angers et en Maine-et-Loire : rénovation complète de maison, d'appartement et de locaux professionnels."
  path="/zone-intervention"
  breadcrumb={[{ name: "Accueil", path: "/" }, { name: "Zone d’intervention" }]}
>
  <PageHeader
    kicker="ZONE D’INTERVENTION"
    title="Votre entreprise de rénovation à Saint-Jean-de-la-Croix et autour d’Angers"
    intro="Basés à Saint-Jean-de-la-Croix, près d’Angers, nous intervenons auprès des particuliers et des professionnels : rénovation complète d’une maison ou d’un appartement, rénovation intérieure, rénovation extérieure et travaux de locaux professionnels."
    titleWidth={26}
  />

  <section>
    <div style="max-width: var(--shell); margin: 0 auto; padding: clamp(36px, 5vw, 76px) var(--gutter); display: grid; gap: clamp(24px, 4vw, 56px); grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr)); align-items: start">

      <div>
        <h2 style={h2}>Secteurs couverts</h2>
        <ul style="list-style: none; padding: 0; margin: 0 0 26px; display: flex; flex-direction: column; gap: 12px">
          {company.serviceArea.map((z) => (
            <li class="blueprint" style="position: relative; padding: 18px; font-family: var(--font-heading); font-size: 21px">
              <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
              {z}
            </li>
          ))}
        </ul>
        <p style="font-size: 14.5px; line-height: 1.6; color: var(--color-neutral-700); max-width: 52ch; margin: 0 0 22px">
          Votre commune n’est pas listée ? Contactez-nous pour vérifier si nous pouvons intervenir
          sur votre chantier.
        </p>
        <a class="btn btn-primary blueprint" href={url('/contact')} data-analytics="click_quote"
           style="white-space: nowrap; min-height: 50px; padding: 13px 22px; font-size: 15.5px">
          <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
          Demander un devis
        </a>
      </div>

      <div>
        <h2 style={h2}>Nous situer</h2>
        <!-- Carte chargée en différé : elle ne pèse pas sur le premier rendu, et
             l'adresse ci-dessous reste utilisable si elle ne charge pas. -->
        <div class="blueprint" style="position: relative; aspect-ratio: 4 / 3; margin-bottom: 20px">
          <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
          <iframe
            src={mapEmbed}
            title={`Carte de localisation de ${company.name} à ${address.city}`}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            style="display: block; width: 100%; height: 100%; border: 0"
          ></iframe>
        </div>
        <address style="font-style: normal; font-size: 15.5px; line-height: 1.7">
          <strong style="font-family: var(--font-heading); font-size: 19px">{company.name}</strong><br />
          {address.street}<br />
          {address.postalCode} {address.city}<br />
          {address.region}, {address.country}
        </address>
        <div style="display: flex; flex-wrap: wrap; gap: 10px; margin-top: 18px">
          <a class="btn btn-secondary" href={itinerary} target="_blank" rel="noopener noreferrer"
             style="white-space: nowrap; min-height: 46px; padding: 12px 18px">Itinéraire</a>
          <a class="btn btn-secondary" href={company.phone.href} data-analytics="click_phone"
             style="white-space: nowrap; min-height: 46px; padding: 12px 18px">{company.phone.display}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Reponses factuelles directes.
       Chaque ligne est verifiable et tenue courte : c'est la forme la plus
       facilement extraite par un moteur de recherche generatif, et la plus
       rapide a lire pour un visiteur qui verifie « est-ce qu'ils viennent
       chez moi ? ». Aucune FAQ fictive, aucun chiffre invente. -->
  <section class="on-surface" style="background: var(--color-surface)">
    <div style="max-width: var(--shell); margin: 0 auto; padding: clamp(36px, 5vw, 76px) var(--gutter)">
      <h2 style={h2}>En bref</h2>
      <dl style="margin: 0; display: grid; gap: 0; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr))">
        <div style="padding: 20px 0; border-top: 1px solid var(--color-divider); padding-right: 28px">
          <dt style="font-family: var(--font-heading); font-size: 18px; text-transform: uppercase; letter-spacing: 0.02em">Où nous sommes basés</dt>
          <dd style="margin: 8px 0 0; font-size: 15px; line-height: 1.6; color: var(--color-neutral-800)">
            {address.street}, {address.postalCode} {address.city}, en {address.region}, au sud d’Angers.
          </dd>
        </div>
        <div style="padding: 20px 0; border-top: 1px solid var(--color-divider); padding-right: 28px">
          <dt style="font-family: var(--font-heading); font-size: 18px; text-transform: uppercase; letter-spacing: 0.02em">Où nous intervenons</dt>
          <dd style="margin: 8px 0 0; font-size: 15px; line-height: 1.6; color: var(--color-neutral-800)">
            À {address.city}, à Angers et ses alentours, et plus largement en {address.region}
            selon la nature du chantier.
          </dd>
        </div>
        <div style="padding: 20px 0; border-top: 1px solid var(--color-divider); padding-right: 28px">
          <dt style="font-family: var(--font-heading); font-size: 18px; text-transform: uppercase; letter-spacing: 0.02em">Pour qui</dt>
          <dd style="margin: 8px 0 0; font-size: 15px; line-height: 1.6; color: var(--color-neutral-800)">
            Particuliers et professionnels, en construction neuve comme en rénovation.
          </dd>
        </div>
        <div style="padding: 20px 0; border-top: 1px solid var(--color-divider); padding-right: 28px">
          <dt style="font-family: var(--font-heading); font-size: 18px; text-transform: uppercase; letter-spacing: 0.02em">Quels travaux</dt>
          <dd style="margin: 8px 0 0; font-size: 15px; line-height: 1.6; color: var(--color-neutral-800)">
            Rénovation complète, rénovation intérieure et rénovation extérieure. Dans ce cadre,
            nous réalisons notamment&nbsp;:{' '}
            {services.map((s, i) => (
              <>
                {i > 0 && ', '}
                <a class="link-more" href={url(`/prestations/${s.slug}`)} style="font-size: 15px">{s.name.toLowerCase()}</a>
              </>
            ))}. Sur toute la zone d’intervention.
          </dd>
        </div>
        <div style="padding: 20px 0; border-top: 1px solid var(--color-divider); padding-right: 28px">
          <dt style="font-family: var(--font-heading); font-size: 18px; text-transform: uppercase; letter-spacing: 0.02em">Comment nous joindre</dt>
          <dd style="margin: 8px 0 0; font-size: 15px; line-height: 1.6; color: var(--color-neutral-800)">
            Par téléphone au <a class="link-more" href={company.phone.href} style="font-size: 15px">{company.phone.display}</a>,
            par email à <a class="link-more" href={company.email.href} style="font-size: 15px">{company.email.display}</a>,
            ou via le <a class="link-more" href={url('/contact')} style="font-size: 15px">formulaire de demande de devis</a>.
          </dd>
        </div>
        <div style="padding: 20px 0; border-top: 1px solid var(--color-divider); padding-right: 28px">
          <dt style="font-family: var(--font-heading); font-size: 18px; text-transform: uppercase; letter-spacing: 0.02em">Devis</dt>
          <dd style="margin: 8px 0 0; font-size: 15px; line-height: 1.6; color: var(--color-neutral-800)">
            Chaque chantier fait l’objet d’un devis établi après échange sur votre projet.
          </dd>
        </div>
      </dl>
    </div>
  </section>
</BaseLayout>
