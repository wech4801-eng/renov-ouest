# URL publique du site (utilisee pour les canonical, le sitemap et l'Open Graph)
PUBLIC_SITE_URL=https://www.renovouest.fr

# Endpoint du formulaire de devis.
# Par defaut : endpoint PHP livre dans public/api/contact.php (compatible Hostinger).
# Remplacable par un service externe sans toucher au front.
PUBLIC_FORM_ENDPOINT=/api/contact.php

# --- Variables lues par public/api/contact.php (a definir sur l'hebergeur) ---
# Destinataire des demandes de devis
CONTACT_TO=renovouest49@gmail.com
# SMTP (recommande : plus fiable que mail()). Laisser vide pour retomber sur mail().
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=tls
