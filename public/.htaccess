# Renov'Ouest — configuration Apache (Hostinger, hebergement mutualise)
# Astro genere un site statique ; la doc Astro precise que les slashs finaux
# des pages pre-rendues sont geres par l'hebergeur. Ce fichier fait ce travail.

Options -Indexes
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- Domaine canonique -----------------------------------------------------
  # A ACTIVER une fois le domaine et le certificat en place (cf. README).
  # RewriteCond %{HTTPS} !=on
  # RewriteRule ^ https://www.renovouest.fr%{REQUEST_URI} [R=301,L]
  # RewriteCond %{HTTP_HOST} !^www\. [NC]
  # RewriteRule ^ https://www.renovouest.fr%{REQUEST_URI} [R=301,L]

  # --- Une seule forme d'URL : sans slash final ------------------------------
  # Le site declare des canonical sans slash (/contact) et le sitemap aussi.
  # Sans ces regles, mod_dir redirigerait /contact vers /contact/ : chaque URL
  # du sitemap couterait une redirection et ne correspondrait plus au canonical.

  # 1) /contact/ -> /contact (301)
  RewriteCond %{REQUEST_URI} !^/$
  RewriteRule ^(.*)/$ /$1 [R=301,L]

  # 2) /contact -> /contact/index.html (reecriture interne, sans redirection)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ /$1/index.html [L]
</IfModule>

# mod_dir ajouterait sinon le slash avant que mod_rewrite n'agisse.
<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>

ErrorDocument 404 /404.html

# --- Compression -------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml
</IfModule>

# --- Cache -------------------------------------------------------------------
# Les fichiers de /_astro/ portent une empreinte dans leur nom : cache long.
# Le HTML reste revalide a chaque visite pour que les mises a jour sortent vite.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|avif|webp|jpg|png|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --- Types MIME --------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType font/woff2 .woff2
</IfModule>
